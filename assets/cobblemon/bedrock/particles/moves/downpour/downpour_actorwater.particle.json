				"max_lifetime": "math.random(1.2,1.8)"
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.30": "watermist",
					"0.60": "watermist",
					"0.90": "watermist",
					"1.15": "watermist"
				}
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_1*3)*90"
			},
			"minecraft:particle_initial_speed": "math.random(6,12)*1.65",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -12, 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["((0.3-(v.particle_random_4*0.125))*v.quiver)*v.shrink", "((0.3-(v.particle_random_4*0.125))*v.quiver)*v.shrink"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 56,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [0, 8],
						"frames_per_second": 12,
						"max_frame": 7,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"1.0": "#FF1d368a"
					}
				}
			}
