				"texture": "textures/particles/generic/impact/impact_water"
			}
		},
		"curves": {
			"variable.quiver": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0.33, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9, 1, 0.9]
			},
			"variable.shrink": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 0.99, 0.97, 0.93, 0.83, 0.54, 0]
			}
		},
		"events": {
			"watermist": {
				"particle_effect": {
					"effect": "cobblemon:downpour_actormist",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, -0.2, 0],
				"radius": 0.3,
				"direction": ["(v.particle_random_1-0.5)*0.3", "(v.particle_random_2+0.55)*0.9", "(v.particle_random_3-0.5)*0.3"]
