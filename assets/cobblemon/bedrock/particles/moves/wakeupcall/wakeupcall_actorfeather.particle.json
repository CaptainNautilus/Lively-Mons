{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:wakeupcall_actorfeather",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/moves/aerialdance_feather"
			}
		},
		"curves": {
			"variable.fun": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 1, 1, 1, 1, 1, 0.96, 0.85, 0.6, -0.05]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "120 * math.max(q.entity_radius,1)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.8
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "(q.entity_radius+0.1)/3",
				"surface_only": true,
				"direction": ["math.random(-1,1)", "math.random(-1,1)+0.5", "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.25,0.75)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": "math.random(15,40)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "-(v.particle_random_4 * 6) - 6", 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.5*v.fun", "0.5*v.fun"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [16, 0],
						"frames_per_second": 10,
						"max_frame": 8,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 1,
				"collision_radius": 0.15,
				"expire_on_contact": true
			}
		}
	}
}