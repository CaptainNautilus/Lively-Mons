{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:mortarshot_actorcinders",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/impact/impact_rock"
			}
		},
		"curves": {
			"variable.rsize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 1, 1, 1, 1, 1, 1]
			}
		},
		"events": {
			"lavasmoke": {
				"particle_effect": {
					"effect": "cobblemon:mortarshot_actorsmoke",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random_integer(2,4)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.25
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, -0.2, 0],
				"direction": ["(v.particle_random_1-0.5)*0.3", "(v.particle_random_2+0.55)*0.9", "(v.particle_random_3-0.5)*0.3"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.8,1.4)"
			},
			"minecraft:particle_lifetime_events": {
				"timeline": {
					"0.30": "lavasmoke",
					"0.60": "lavasmoke",
					"0.90": "lavasmoke",
					"1.15": "lavasmoke"
				}
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_1*3)*90"
			},
			"minecraft:particle_initial_speed": "math.random(6,12)*2.65",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -32, 0],
				"linear_drag_coefficient": 3
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.15*v.rsize", "0.15*v.rsize"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 8,
					"texture_height": 56,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [8, 8],
						"step_UV": [0, 8],
						"frames_per_second": 16,
						"max_frame": 7,
						"loop": true
					}
				}
			},
            "minecraft:particle_appearance_lighting": {},
			"minecraft:particle_motion_collision": {
				"collision_drag": 2,
				"coefficient_of_restitution": 1,
				"collision_radius": 0.1
			}
		}
	}
}