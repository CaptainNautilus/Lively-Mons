{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:aerialdance_actorfeather",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/moves/aerialdance_feather"
			}
		},
		"curves": {
			"variable.crtrailsize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.67, 1, 1, 0.9, 0.5, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 60,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.125
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, 0],
				"direction": ["math.sin(v.emitter_age*2590)*(v.particle_random_1*0.25)", "((v.particle_random_2-0.5)*0.33)", "(v.particle_random_3+0.5)*0.25"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "0.45+(v.particle_random_4*0.1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": "2.5-(v.particle_random_4*1)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 1, 0],
				"linear_drag_coefficient": "(v.particle_random_4*0.5)*6"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["(0.5-(v.particle_random_4*0.04))*(v.crtrailsize)", "(0.5-(v.particle_random_4*0.04))*(v.crtrailsize)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [16, 0],
						"frames_per_second": 10,
						"max_frame": 8,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.23": "#FFFFFFFF",
						"0.75": "#BFFFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}