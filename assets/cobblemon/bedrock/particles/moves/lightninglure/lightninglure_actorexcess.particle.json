{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:lightninglure_actorexcess",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/white"
			}
		},
		"curves": {
			"variable.fursize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 0.9, 1, 1, 1, 1, 0.9, 0.6, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 250,
				"max_particles": 10000
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.7
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0,
				"offset": [0, 0.1, 0],
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": "(math.clamp(v.entity_width,1,2.5)*4)+(v.particle_random_4*0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "-math.clamp(v.entity_height*1.5,2,4)*1.3", 0],
				"linear_drag_coefficient": "0.5+(math.clamp(v.entity_width,1,2.5)*0.5)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
                    "0.1*math.clamp(v.particle_random_2*0.5,0.65,1)*math.max(q.entity_size,0.3)*0.2*v.fursize",
                    "0.1*math.clamp(v.particle_random_2*0.5,0.65,1)*math.max(q.entity_size,0.3)*(v.particle_age<(v.particle_lifetime*0.5) ? 0.2 : 0.175)*v.fursize"
                ],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 63,
					"texture_height": 9,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [9, 9],
						"step_UV": [9, 0],
						"frames_per_second": 1,
						"max_frame": 7,
						"stretch_to_lifetime": true
					}
				}
            },
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFEC97",
						"0.18": "#ffffffff",
						"0.36": "#FFFFEC97",
						"1.0": "#FFFFD675"
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.4,
				"coefficient_of_restitution": 0.4,
				"collision_radius": 0.01
			}
		}
	}
}