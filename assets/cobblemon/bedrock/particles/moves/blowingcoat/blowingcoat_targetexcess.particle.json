{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:blowingcoat_targetexcess",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/moves/billowingcoat"
			}
		},
		"curves": {
			"variable.fursize": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 1, 0.66, 0.33, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 10
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.2
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0, 0],
				"direction": ["v.particle_random_1-0.5", "0.25+(v.particle_random_2*0.35)", "v.particle_random_3-0.5"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.6
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.round(v.particle_random_4*3)*90"
			},
			"minecraft:particle_initial_speed": 4,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -3, 0],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
                    "2*math.clamp(v.particle_random_2*0.5,0.65,1)*math.max(q.entity_size,0.3)*0.2*v.fursize",
                    "2*math.clamp(v.particle_random_2*0.5,0.65,1)*math.max(q.entity_size,0.3)*(v.particle_age<(v.particle_lifetime*0.5) ? 0.2 : 0.175)*v.fursize"
                ],
				"facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 48,
                    "texture_height": 256,
                    "uv": [
                        "math.floor(v.particle_random_4*3)*16",
                        "math.clamp(math.floor((v.particle_age/4)*18)*16,0,240)"
                    ],
                    "uv_size": [
                        16,
                        16
                    ]
                }
            },
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#ffa0939b",
						"0.85": "#ff6a4f60",
						"1.0": "#006a4f60"
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.8,
				"coefficient_of_restitution": 0.8,
				"collision_radius": 0.01
			}
		}
	}
}