{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:crashlanding_actor_swirl",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particles/generic/psychic/psyspiral"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "6 * math.clamp((v.entity_radius * 3),24,45)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.1, 0],
				"radius": "math.clamp(v.entity_radius,0.5,3)",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2,3)"
			},
			"minecraft:particle_initial_speed": "2 * math.clamp((v.particle_random_4*3),2,6)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.clamp((v.particle_random_4*2),1,8)", 0],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["math.clamp((v.entity_radius * 0.5),0.4,0.7) * v.particle_random_1 / (1 + v.particle_age)", "math.clamp((v.entity_radius * 0.5),0.4,0.7) * v.particle_random_1 / (1 + v.particle_age)"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 16,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [16, 0],
						"frames_per_second": 24,
						"max_frame": 8,
						"loop": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"1.0": "#001A007B"
					}
				}
			}
		}
	}
}