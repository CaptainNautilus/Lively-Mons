{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:jetstream_dust",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/impact/impact_flying"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 150,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.18
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "math.clamp(query.entity_radius,1,50)",
				"surface_only": true,
				"direction": [0, 0, 1]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.25,0.6)"
			},
            "minecraft:particle_initial_spin": {
                "rotation": "math.random(0,360)"
            },
			"minecraft:particle_initial_speed": 4,
			"minecraft:particle_motion_parametric": {
				"relative_position": ["math.sin(v.particle_age*90*4-v.particle_random_1*360)*(v.entity_width*(1.2/math.clamp(v.entity_width*0.9,1,255)))", "math.cos(v.particle_age*90*4-v.particle_random_1*360)*(v.entity_width*(1.2/math.clamp(v.entity_width*0.9,1,255)))", "v.particle_random_3+v.particle_age*16"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["0.4*math.clamp(v.particle_random_3 * 0.5, 0.5,2)", "0.4*math.clamp(v.particle_random_3 * 0.5, 0.5,2)"],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 8,
                    "texture_height": 56,
                    "flipbook": {
                        "base_UV": [
                            0,
                            0
                        ],
                        "size_UV": [
                            8,
                            8
                        ],
                        "step_UV": [
                            0,
                            8
                        ],
                        "frames_per_second": 20,
                        "max_frame": 7,
                        "stretch_to_lifetime": true
                    }
                }
            },
            "cobblemon:emitter_space": {
                "scaling": "entity"
            }
        }
    }
