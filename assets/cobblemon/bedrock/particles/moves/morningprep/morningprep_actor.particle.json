{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "cobblemon:morningprep_actor",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/generic/grass/xsseed"
			}
		},
		"events": {
			"impact": {
				"particle_effect": {
					"effect": "cobblemon:leechseed_target",
					"type": "particle"
				}
			},
			"sprout": {
				"particle_effect": {
					"effect": "cobblemon:leechseed_sprout",
					"type": "particle"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "7*v.entity_width",
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.6
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.1, 0],
				"direction": ["math.random(-1,1)*v.entity_width", 1, "math.random(-1,1)*v.entity_width"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.6
			},
			"minecraft:particle_lifetime_events": {
				"expiration_event": ["impact", "sprout"]
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random_integer(0,3)*90"
			},
			"minecraft:particle_initial_speed": "math.random(4,6)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -20, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.125, 0.125],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 56,
					"texture_height": 7,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [7, 7],
						"step_UV": [7, 0],
						"frames_per_second": 16,
						"max_frame": 8,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.1,
				"expire_on_contact": true
			},
			"minecraft:particle_appearance_lighting": {}
		}
	}
}