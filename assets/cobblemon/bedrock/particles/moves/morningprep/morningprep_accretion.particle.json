{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "cobblemon:morningprep_accretion",
            "basic_render_parameters": {
				"material": "particles_add",
                "texture": "textures/particles/generic/orb/orb"
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 18,
                "max_particles": 100
            },
            "minecraft:emitter_lifetime_once": {
                "active_time": 0.8
            },
            "minecraft:emitter_shape_sphere": {
                "radius": "v.entity_width",
                "surface_only": true,
                "direction": "inwards",
				"offset": [0, 0, 0]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": 0.85
            },
            "minecraft:particle_initial_speed": 0.125,
            "minecraft:particle_motion_dynamic": {
                "linear_drag_coefficient": -4.75
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "-0.1*math.cos(v.particle_age*90*4*1.15-45)+0.1",
                    "-0.1*math.cos(v.particle_age*90*4*1.15-45)+0.1"
                ],
                "facing_camera_mode": "rotate_xyz",
                "uv": {
                    "texture_width": 8,
                    "texture_height": 8,
                    "uv": [
                        0,
                        0
                    ],
                    "uv_size": [
                        8,
                        8
                    ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#00FF9600",
                        "0.48": "#40FFFA8D",
                        "1.0": "#94D7FEFF"
                    }
                }
            },
            "cobblemon:emitter_space": {
                "scaling": "entity"
            }
        }
    }
}