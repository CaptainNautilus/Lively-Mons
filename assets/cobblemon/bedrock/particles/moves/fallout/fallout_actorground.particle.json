{
    "format_version": "1.10.0",
    "particle_effect": {
        "description": {
            "identifier": "cobblemon:fallout_actorground",
            "basic_render_parameters": {
                "material": "particles_blend",
                "texture": "textures/particles/generic/smoke/obscuringsmoke"
            }
        },
        "curves": {
            "variable.gassize": {
                "type": "linear",
                "input": "v.particle_age",
                "horizontal_range": "v.particle_lifetime",
                "nodes": [
                    0,
                    1,
                    1,
                    1,
                    1,
                    1
                ]
            }
        },
        "components": {
            "minecraft:emitter_rate_steady": {
                "spawn_rate": 280,
                "max_particles": 2000
            },
            "minecraft:emitter_lifetime_looping": {
                "active_time": 2.25
            },
            "minecraft:emitter_shape_disc": {
                "offset": [
                    0,
                    0,
                    -1
                ],
                "radius": "math.random(2,6)",
                "direction": [
                    "math.random(-1,1)",
                    "math.random(0,0.25)",
                    "math.random(-1,1)"
                ]
            },
            "minecraft:particle_lifetime_expression": {
                "max_lifetime": "math.random(1.25,1.75)"
            },
            "minecraft:particle_initial_spin": {
                "rotation": 0
            },
            "minecraft:particle_initial_speed": "math.random(1.25,4.45)*0.1",
            "minecraft:particle_motion_dynamic": {
                "linear_acceleration": [
                    0,
                    0.5,
                    0
                ],
                "linear_drag_coefficient": 2
            },
            "minecraft:particle_appearance_billboard": {
                "size": [
                    "0.5*v.gassize",
                    "0.25*v.gassize"
                ],
                "facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 80,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 8],
						"step_UV": [0, 8],
						"frames_per_second": 5,
						"max_frame": 10,
						"stretch_to_lifetime": true
					}
                }
            },
            "minecraft:particle_motion_collision": {
                "collision_radius": 0.01,
                "expire_on_contact": true
            },
            "minecraft:particle_appearance_tinting": {
                "color": {
                    "interpolant": "v.particle_age / v.particle_lifetime",
                    "gradient": {
                        "0.0": "#3874b752",
                        "0.28": "#A028944d",
                        "0.67": "#A094af86",
                        "1.0": "#009ccdad"
                    }
                }
