{
  "portraitScale": 1.14,
  "portraitTranslation": [-0.66, 1.91, 0],
  "profileScale": 0.48,
  "profileTranslation": [0, 0.99, -3],
  "rootBone": "laprise",
  "firstPersonCameraOffset": {
    "seat_1": [0, 0.45, 0],
    "seat_2": [0, 0.45, 0]
  },
  "thirdPersonCameraOffset": {
    "seat_1": [0, 0.45, 0],
    "seat_1_reverse": [0, 0.45, 0],
    "seat_2": [0, 0.45, 0],
    "seat_2_reverse": [0, 0.45, 0]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 0.45, 0],
    "seat_1_reverse": [0, 0.45, 0],
    "seat_2": [0, 0.45, 0],
    "seat_2_reverse": [0, 0.45, 0]
  },
  "animations": {
    "faint": "q.bedrock_primary('laprise', 'faint')",
    "cry": "q.bedrock_stateful('laprise', 'cry')",
    "recoil": "q.bedrock_stateful('laprise', 'recoil')"
  },
  "poses": {
    "in-air": {
      "poseTypes": ["STAND", "WALK"],
      "isBattle": false,
      "condition": "q.in_air && q.is_ridden && q.has_entity",
      "animations": ["q.look('head')", "q.bedrock('laprise', 'ride_ground_jump')"],
      "transformTicks": 4,
      "transformToTicks": 4
    },
    "battle-standing": {
      "poseTypes": ["STAND"],
      "isBattle": true,
      "namedAnimations": {
        "cry": "q.bedrock_primary('laprise', 'status', q.curve('symmetrical_wide'))",
        "special": "q.bedrock_primary('laprise', 'special', q.curve('symmetrical_wide'))",
        "status": "q.bedrock_primary('laprise', 'status', q.curve('symmetrical_wide'))"
      },
      "animations": ["q.look('head')", "q.bedrock('laprise', 'ground_idle')"],
      "quirks": ["q.bedrock_quirk('laprise', 'blink')"]
    },
    "air-battle-standing": {
      "poseTypes": ["STAND", "HOVER"],
      "isBattle": true,
      "namedAnimations": {
        "cry": "q.bedrock_primary('laprise', 'air_status', q.curve('symmetrical_wide'))",
        "special": "q.bedrock_primary('laprise', 'air_special', q.curve('symmetrical_wide'))",
        "status": "q.bedrock_primary('laprise', 'air_status', q.curve('symmetrical_wide'))",
        "faint": "q.bedrock_primary('laprise', 'air_faint')"
      },
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'air_idle')"
      ],
      "quirks": ["q.bedrock_quirk('laprise', 'blink')"]
    },
    "standing": {
      "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"],
      "condition": "q.has_entity ? !q.in_air : 1.0",
      "isBattle": false,
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'ground_idle')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('laprise', 'ride_ground_walk')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('laprise', 'blink')",
        "q.bedrock_quirk('laprise', q.array('quirk', 'quirk2'))"
      ]
    },
    "walking": {
      "poseTypes": ["WALK"],
      "condition": "q.has_entity ? !q.in_air : 1.0",
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'ground_walk')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('laprise', 'ride_ground_walk')"
        }
      ],
      "quirks": ["q.bedrock_quirk('laprise', 'blink')"]
    },
    "hover": {
      "poseTypes": ["HOVER", "FLOAT"],
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'air_idle')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('laprise', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('laprise', 'blink')",
        "q.bedrock_quirk('laprise', q.array('quirk', 'quirk2'))"
      ]
    },
    "fly": {
      "poseTypes": ["FLY", "SWIM"],
      "condition": "!q.is_gliding",
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'air_fly')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('laprise', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('laprise', 'blink')",
        "q.bedrock_quirk('laprise', q.array('quirk', 'quirk2'))"
      ]
    },
    "glide": {
      "poseTypes": ["FLY", "SWIM"],
      "condition": "q.is_gliding",
      "animations": [
        "q.look('head')",
        "q.bedrock('laprise', 'air_glide')",
        "q.bedrock('laprise', 'ride_dive')",
        {
          "condition": "q.is_ridden && q.has_entity",
          "animation": "q.bedrock('laprise', 'ride_air_fly')"
        }
      ],
      "quirks": [
        "q.bedrock_quirk('laprise', 'blink')",
        "q.bedrock_quirk('laprise', q.array('quirk', 'quirk2'))"
      ],
      "transformTicks": 10
    },
    "sleep": {
      "poseTypes": ["SLEEP"],
       "condition": "!q.is_flying",
      "namedAnimations": {
        "cry": "q.bedrock_stateful('dummy', 'cry')"
      },
      "animations": ["q.bedrock('laprise', 'sleep')"]
    },
    "air-sleep": {
      "poseTypes": ["SLEEP"],
       "condition": "q.is_flying",
      "namedAnimations": {
        "cry": "q.bedrock_stateful('dummy', 'cry')"
      },
      "animations": ["q.bedrock('laprise', 'air_sleep')"]
    }
  }
}