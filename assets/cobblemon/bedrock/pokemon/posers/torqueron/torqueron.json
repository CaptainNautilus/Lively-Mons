{
  "portraitScale": 2,
  "portraitTranslation": [-1.9, -1.15, 0],
  "profileScale": 0.35,
  "profileTranslation": [0, 1.2, 0],
  "rootBone": "torqueron",
  "firstPersonCameraOffset": {
    "seat_1": [0, 0.45, 0]
  },
  "thirdPersonCameraOffset": {
    "seat_1": [0, 0.35, 0],
    "seat_1_reverse": [0, 0.35, 0]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 0.35, 0],
    "seat_1_reverse": [0, 0.35, 0]
  },
  "animations": {
    "faint": "q.bedrock_primary('torqueron', 'faint', q.curve('symmetrical'))",
    "cry": "q.bedrock_stateful('torqueron', 'cry')",
    "recoil": "q.bedrock_stateful('torqueron', 'recoil')"
  },
  "poses": {
    "battle-standing": {
      "poseName": "standing",
      "poseTypes": ["STAND","FLOAT"],
      "isBattle": true,
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('torqueron', 'battle_idle')"
      ],
      "transformTicks": 10,
      "quirks": [
        "q.bedrock_quirk('torqueron', 'blink')"
      ]
    },
    "standing": {
      "poseName": "standing",
      "poseTypes": ["STAND","FLOAT","PROFILE","PORTRAIT"],
      "isBattle": false,
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('torqueron', 'ground_idle')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('torqueron', 'ride_ground_idle')"
        }
      ],
      "transformTicks": 10,
      "quirks": [
        "q.bedrock_quirk('torqueron', 'blink')"
      ]
    },
    "in-air": {
      "poseTypes": ["STAND", "WALK"],
      "condition": "q.in_air",
      "animations": [
        "q.bedrock('torqueron', 'ride_jump')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('torqueron', 'ride_ground_walk')"
        }
      ],
      "transformTicks": 5,
      "transformToTicks": 5,
      "quirks": [
        "q.bedrock_quirk('torqueron', 'blink')"
      ]
    },
    "walking": {
      "poseName": "walking",
      "poseTypes": ["WALK","SWIM"],
      "condition": "!q.is_sprinting",
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('torqueron', 'ground_walk')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('torqueron', 'ride_ground_walk')"
        }
      ],
      "transformTicks": 10,
      "quirks": [
        "q.bedrock_quirk('torqueron', 'blink')"
      ]
    },
    "run": {
      "poseTypes": ["WALK"],
      "condition": "q.is_sprinting",
      "animations": [
        "q.look('head_ai')",
        "q.bedrock('torqueron', 'ground_run')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('torqueron', 'ride_ground_walk')"
        }
      ],
      "transformTicks": 10,
      "quirks": [
        "q.bedrock_quirk('torqueron', 'blink')"
      ]
    },
    "sleep": {
      "poseName": "sleep",
      "poseTypes": ["SLEEP"],
          "namedAnimations": {
          "cry": "q.bedrock_stateful('dummy', 'cry')"
          },
      "animations": [
        "q.bedrock('torqueron', 'sleep')"
      ],
      "transformTicks": 10
    }
  }
}