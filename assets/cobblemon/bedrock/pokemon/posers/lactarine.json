{
      "portraitScale": 2.5,
      "portraitTranslation": [0.2, -1.65, 0],
      "profileScale": 0.8,
      "profileTranslation": [0, 0.5, 0],
  "rootBone": "lactarine",
  "firstPersonCameraOffset": {
    "seat_1": [0, 0.45, 0],
    "seat_2": [0, 0.45, 0],
    "seat_3": [0, 0.45, 0]
  },
  "thirdPersonCameraOffset": {
    "seat_1": [0, 0.4, 1],
    "seat_1_reverse": [0, 0.4, 1],
    "seat_2": [0, 0.4, 1],
    "seat_2_reverse": [0, 0.4, 1],
    "seat_3": [0, 0.4, 1],
    "seat_3_reverse": [0, 0.4, 1]
  },
  "thirdPersonCameraOffsetNoViewBobbing": {
    "seat_1": [0, 0.4, 1],
    "seat_1_reverse": [0, 0.4, 1],
    "seat_2": [0, 0.4, 1],
    "seat_2_reverse": [0, 0.4, 1],
    "seat_3": [0, 0.4, 1],
    "seat_3_reverse": [0, 0.4, 1]
  },
  "animations": {
    "faint": "q.bedrock_primary('lactarine', 'faint', q.curve('symmetrical'))",
    "cry": "q.bedrock_stateful('lactarine', 'cry')",
    "recoil": "q.bedrock_stateful('lactarine', 'recoil')"
  },
  "poses": {
    "battle-standing": {
      "poseTypes": ["STAND"],
      "isBattle": true,
      "animations": ["q.look('head')", "q.bedrock('lactarine', 'battle_idle')"]
    },
    "in-air": {
      "poseTypes": ["STAND", "WALK", "FLOAT"],
      "isBattle": false,
      "condition": "q.in_air && q.is_ridden && q.has_entity",
      "animations": ["q.look('head')", "q.bedrock('lactarine', 'ride_jump')"],
      "transformTicks": 2,
      "transformToTicks": 2
    },
    "standing": {
      "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"],
      "isBattle": false,
      "condition": "q.has_entity ? !q.in_air : 1.0",
      "animations": ["q.look('head')", "q.bedrock('lactarine', 'ground_idle')"]
    },
    "walking": {
      "poseTypes": ["WALK", "SWIM"],
      "condition": "!q.in_air && !q.is_sprinting",
      "animations": [
        "q.look('head')",
        "q.bedrock('lactarine', 'ground_walk')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('lactarine', 'ride_ground_walk')"
        }
      ]
    },
    "running": {
      "poseTypes": ["WALK"],
      "condition": "!q.in_air && q.is_sprinting",
      "animations": [
        "q.look('head')",
        "q.bedrock('lactarine', 'ground_run')",
        {
          "condition": "q.is_ridden",
          "animation": "q.bedrock('lactarine', 'ride_ground_run')"
        }
      ]
    },
    "sleep": {
      "poseTypes": ["SLEEP"],
      "namedAnimations": {
        "cry": "q.bedrock_stateful('dummy', 'cry')"
      },
      "animations": ["q.bedrock('lactarine', 'sleep')"]
    }
  }
}